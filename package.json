{
  "name": "novelripple",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "predev": "npm run db:migrate",
    "dev": "next dev",
    "build": "next build",
    "prestart": "npm run db:migrate",
    "start": "next start",
    "lint": "eslint .",
    "pretypecheck": "next typegen",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:watch": "vitest",
    "test:e2e": "tsx scripts/run-e2e.ts",
    "eval:live": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/eval-live.ts",
    "eval:m1:baseline": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/eval-m1-baseline.ts",
    "eval:m1:ripple-guidance": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/eval-m1-ripple-guidance.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "fixture:build": "tsx scripts/build-fixture.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@xyflow/react": "12.11.2",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "next": "16.3.0",
    "openai": "7.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.13",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "tsx": {
      "esbuild": "0.28.2"
    }
  }
}
