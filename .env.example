# Local SQLite file. Keep real data outside version control.
DB_FILE_NAME=.data/novelripple.db

# Server-only OpenAI-compatible Chat Completions endpoint.
# The model is selected explicitly by each generation call.
AI_PROVIDER_NAME=openai-compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# Explicit only: json_schema, json_object, or prompt_json. No auto fallback.
OPENAI_STRUCTURED_OUTPUT_MODE=json_schema

# Optional private benchmark root outside the repository. Unset/empty = only the
# repository roots (benchmarks/m1/public and benchmarks/private).
# Manifests there must use visibility=private.
# NOVELRIPPLE_BENCH_ROOT=
